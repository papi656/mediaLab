# --- provider ---------------------------------------------------------------
# fake = no network, deterministic images. Use this for development and tests.
# openrouter = real generation, costs money.
PROVIDER=fake
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- auth -------------------------------------------------------------------
# 32+ chars. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
# The server refuses to start with PROVIDER != fake while this is the default.
SESSION_SECRET=dev-only-insecure-secret-change-me
SESSION_DAYS=7
# Preferred: bcrypt hash. Generate with: uv run python -m app.hashpw
ADMIN_PASSWORD_HASH=
# Dev-only fallback when no hash is set: plaintext password.
ADMIN_PASSWORD=medialab
# Empty = derive from PROVIDER: red (Secure + __Host- prefix) for anything that is
# not fake, off for fake so local HTTP dev works. Set true/false to override.
COOKIE_SECURE=

# --- ingress ----------------------------------------------------------------
# Which peers may set X-Forwarded-For. uvicorn reads this variable itself, so the
# Dockerfile does not pass the flag. NEVER "*": that lets any peer forge the client
# address and rotate past the login rate limiter.
#
# Production (Cloudflare Tunnel -> loopback-published port): the peer is the Docker
# gateway in front of the container, because that is what NATs a host-side
# connection (verified: 172.17.0.1 on the default bridge). Read it on the VPS:
#   docker network inspect <coolify-network> --format '{{range .IPAM.Config}}{{.Gateway}}{{end}}'
# Local dev: the default (loopback) is correct because nothing fronts the process.
FORWARDED_ALLOW_IPS=127.0.0.1,::1
# Serve /api/docs and /api/openapi.json. Off unless someone asks.
ENABLE_DOCS=0

# --- storage ----------------------------------------------------------------
DATA_DIR=./data
# Dev/tests migrate at startup because nothing else will. Production sets this to 0
# and runs `alembic upgrade head` as the Coolify pre-deployment command, so a failed
# migration aborts the deploy while the old container still serves (D7). With it off,
# startup verifies the schema is at head and refuses to boot otherwise.
RUN_MIGRATIONS_ON_START=1
STATIC_DIR=            # path to the built SPA; empty = API only

# --- resource caps (D4) -----------------------------------------------------
# Per-file upload limit. Cloudflare's Free plan also caps request bodies at 100 MB.
MAX_UPLOAD_MB=10
# Total bytes of one generation's references (before base64, which adds ~33%).
# Without it, 20 x 10 MB references could peak near 500 MB of RAM per request.
MAX_REFERENCE_BYTES=41943040
# Refuse new uploads/generations at or above this % of the data volume. GC is the
# only thing that reclaims space and it runs every GC_INTERVAL_HOURS, so the last
# 15% is headroom for SQLite's WAL, GC and the OS — not for users.
STORAGE_WATERMARK_PCT=85

# --- cost / limits ----------------------------------------------------------
# Mandatory when PROVIDER=openrouter; the server refuses to boot without it.
# Applies only to models with deterministic per-image pricing.
DAILY_BUDGET_USD=
MAX_N_HARD_CAP=4
JOB_TIMEOUT_SECONDS=120

# --- retention --------------------------------------------------------------
SOFT_DELETE_RETENTION_DAYS=7
GC_INTERVAL_HOURS=6

# --- fake provider knobs (tests) --------------------------------------------
FAKE_LATENCY_MS=50
FAKE_FAIL=false
