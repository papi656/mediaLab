# --- provider ---------------------------------------------------------------
# fake = no network, deterministic images. Use this for development and tests.
# openrouter = real generation, costs money.
PROVIDER=fake
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- auth -------------------------------------------------------------------
# 32+ chars. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=dev-only-insecure-secret-change-me
SESSION_DAYS=7
# Preferred: bcrypt hash. Generate with: uv run python -m app.hashpw
ADMIN_PASSWORD_HASH=
# Dev-only fallback when no hash is set: plaintext password.
ADMIN_PASSWORD=medialab

# --- storage ----------------------------------------------------------------
DATA_DIR=./data
STATIC_DIR=            # path to the built SPA; empty = API only
MAX_UPLOAD_MB=20

# --- cost / limits ----------------------------------------------------------
# Empty = no cap. Applies only to models with deterministic per-image pricing.
DAILY_BUDGET_USD=
MAX_N_HARD_CAP=4
JOB_TIMEOUT_SECONDS=120

# --- retention --------------------------------------------------------------
SOFT_DELETE_RETENTION_DAYS=7
GC_INTERVAL_HOURS=6

# --- fake provider knobs (tests) --------------------------------------------
FAKE_LATENCY_MS=50
FAKE_FAIL=false
