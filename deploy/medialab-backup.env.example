# mediaLab backup credentials (D9). Install as /etc/medialab/backup.env, chmod 600.
#
# This file is a bearer secret for the off-host repository: anyone who can read it
# can download every image the service has ever produced and delete the history.
# It is NOT in the repo and must never be committed.
#
# restic -> Backblaze B2 (the default assumption in Q2):
#   restic init   # once, after exporting this file
#
# Create the bucket and an application key limited to that bucket, then fill these:
RESTIC_REPOSITORY=b2:medialab-backup:/medialab
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
# Generate with: openssl rand -base64 32 ; store a copy somewhere off this VPS.
# Without the password the repository cannot be decrypted, and it cannot be reset.
RESTIC_PASSWORD_FILE=/etc/medialab/restic-password

# Optional overrides used by scripts/backup.sh
#DATA_DIR=/srv/medialab/data
#BACKUP_TAG=medialab
#STAGING_DIR=/var/tmp/medialab-backup
# Set to 1 for the weekly run that rewrites pack files (see the timer).
#PRUNE=1
